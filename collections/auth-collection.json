  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Post-Request 1--Login-API",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const expectedStatus =\r",
                  "parseInt(pm.iterationData.get(\"expectedStatus\"));\r",
                  "\r",
                  "pm.test(\"Status code check\", function () {\r",
                  "    pm.response.to.have.status(expectedStatus);\r",
                  "});\r",
                  "\r",
                  "const json = pm.response.json();\r",
                  "\r",
                  "if (expectedStatus === 200) {\r",
                  "\r",
                  "    pm.environment.set(\r",
                  "      \"capturedToken\",\r",
                  "      json.accessToken\r",
                  "    );\r",
                  "\r",
                  "    pm.environment.set(\r",
                  "      \"refreshToken\",\r",
                  "      json.refreshToken\r",
                  "    );\r",
                  "\r",
                  "    pm.test(\"Token exists\", function () {\r",
                  "        pm.expect(\r",
                  "          json.accessToken.startsWith(\"eyJ\")\r",
                  "        ).to.be.true;\r",
                  "    });\r",
                  "\r",
                  "} else {\r",
                  "\r",
                  "    pm.test(\"Error message exists\", function () {\r",
                  "        pm.expect(\r",
                  "          json.message.length\r",
                  "        ).to.be.above(0);\r",
                  "    });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"username\": \"{{csv_username}}\",\r\n  \"password\": \"{{csv_password}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/auth/login",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET-Request 2 — /auth/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r",
                  "pm.test(\"firstName non-empty\", () => {\r",
                  "    pm.expect(pm.response.json().firstName).to.be.a('string').and.not.empty;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "Bearer{{capturedToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseurl}}/auth/me",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        },
