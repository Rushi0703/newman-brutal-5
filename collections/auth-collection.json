                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{ \"refreshToken\": \"{{capturedRefreshToken}}\", \"expiresInMins\": 30 }",
              "options": {
                "raw": {
