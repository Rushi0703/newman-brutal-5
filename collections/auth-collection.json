              "script": {
                "exec": [
                  "// In Pre-request script:\r",
                  "const token = pm.collectionVariables.get(\"capturedToken\") || \"\";\r",
                  "pm.collectionVariables.set(\"tokenPrefix\", token.substring(0, 10));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
