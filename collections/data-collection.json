          "name": "GET-Request1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const expectedStatus = parseInt(pm.iterationData.get('expectedStatus'));\r",
                  "pm.test(\"Status correct\", () => pm.response.to.have.status(expectedStatus));\r",
                  "\r",
                  "if (pm.response.code === 200) {\r",
                  "    const json = pm.response.json();\r",
                  "    const minPrice = parseFloat(pm.iterationData.get('minPrice'));\r",
                  "    const maxPrice = parseFloat(pm.iterationData.get('maxPrice'));\r",
                  "    pm.test(\"Price in range\", () => {\r",
                  "        pm.expect(json.price).to.be.at.least(minPrice);\r",
                  "        pm.expect(json.price).to.be.at.most(maxPrice);\r",
                  "    });\r",
                  "    const expectedCat = pm.iterationData.get('expectedCategory');\r",
                  "    if (expectedCat) {\r",
                  "        pm.test(\"Category matches\", () => pm.expect(json.category).to.eql(expectedCat));\r",
                  "    }\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
